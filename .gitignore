.DS_Store
build/
.build/
DerivedData/
.swiftpm/
xcuserdata/
*.xcuserstate
*.log
bench-output/
__pycache__/
*.pyc
.zcode/

# Local AI-chat sync drafts are not public research artifacts
.tmp-chatgpt-sync/
palace-v0/

# Pre-research runtime artifacts
pre-research/**/*.sqlite

# G2 P0 declares run.log as an evidence artifact (child stdout/stderr, unmodified)
!execution-information-loop/experiment/continuous-calc-verification/model-level-validation/g2/p0/**/run.log

# G2 batch host stdout/stderr is unmodified evidence, not a disposable log
!execution-information-loop/experiment/continuous-calc-verification/model-level-validation/g2/evidence/**/host.log

# G2 A2 materialized model copy (17.2 GB, byte-verified, never committed)
execution-information-loop/experiment/continuous-calc-verification/model-level-validation/g2/artifact-model-*/

# Local working copy of the mlx-swift fork (native G3 storage-identity accessor); see Package.swift path dependency
/vendor/

# Local transfer staging for delivered patch packages (multi-GB, never commit)
/.transfer/

# Compiler/profiling and canvas runtime artifacts
*.profraw
*.canvas.status.json

# Transient working state regenerated by every selftest run; frozen evidence
# lives under docs/02-evidence/ and model-level-validation/g2/evidence/.
execution-information-loop/experiment/continuous-calc-verification/model-level-validation/.carrier-*.sqlite
execution-information-loop/experiment/continuous-calc-verification/model-level-validation/.consistency-check.sqlite
execution-information-loop/experiment/continuous-calc-verification/model-level-validation/.last_judgment.json
