{
  "schema_id": "SIMIGO-NATIVE-PYTHON-CONTRACT-PARITY-V1",
  "purpose": "One shared case file, two engines. Both the Python production gate (declarative_result_contract.validate_result_text) and the native Swift gate (NativeProducerResultContractGate) are run over exactly these cases with exactly these verified bindings; an agreement is recorded per case and any divergence fails the gate.",
  "applies_to": "simigo.result-contract/v1 constructs implemented by BOTH engines: input-binding projection of the ordinary task entry, fields, types, match policies and the equals_binding / concat / equals_field / equals_literal / digest_equals_binding constraints.",
  "declared_divergences": [
    "bindings selectors: the Python engine resolves them from the admitted dependency value maps; the native engine does not implement them, so the ordinary task entry projects them onto IS-verified admission bindings and does not forward the selector list to the engine.",
    "equals_binding_segment is implemented by the Python engine only; a declaration naming it is refused fail-closed by the native engine. (digest_equals_binding was Python-only until K2; the native engine now implements it with the same canonical-JSON SHA-256 convention, so it moved to the shared family above.)",
    "binding values reaching the native engine are strings, because resolve-model-input only admits non-empty string result fields (BINDING_VALUE_INVALID otherwise)."
  ],
  "cases": [
    {
      "name": "route-synthesis-valid",
      "expect": "VALID",
      "contract": {
        "schema_version": "simigo.result-contract/v1",
        "fields": {
          "origin_code": {"pattern": "ORIGIN=([A-Z]+)", "capture_group": 1, "type": "string", "required": true, "match_policy": "first"},
          "destination_code": {"pattern": "DEST=([A-Z]+)", "capture_group": 1, "type": "string", "required": true, "match_policy": "first"},
          "route_key": {"pattern": "ROUTE=([A-Z]+>[A-Z]+)", "capture_group": 1, "type": "string", "required": true, "match_policy": "first"},
          "priority": {"pattern": "PRIORITY=([0-9]+)", "capture_group": 1, "type": "string", "required": true, "match_policy": "first"}
        },
        "constraints": [
          {"kind": "equals_binding", "field": "origin_code", "binding": "origin"},
          {"kind": "equals_binding", "field": "destination_code", "binding": "destination"},
          {"kind": "equals_binding", "field": "priority", "binding": "destination_priority"},
          {"kind": "concat", "field": "route_key", "parts": ["origin_code", "destination_code"], "separator": ">"}
        ]
      },
      "bindings": {"origin": "NORTH", "destination": "EAST", "destination_priority": "5", "route_key": "NORTH>EAST"},
      "text": "ORIGIN=NORTH\nDEST=EAST\nROUTE=NORTH>EAST\nPRIORITY=5",
      "values": {"destination_code": "EAST", "origin_code": "NORTH", "priority": "5", "route_key": "NORTH>EAST"}
    },
