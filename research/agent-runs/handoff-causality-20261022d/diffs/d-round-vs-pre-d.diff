+import Foundation
+import SimiGo2Experimental
+
+struct TaskEntryError: Error, CustomStringConvertible {
+  let description: String
+  init(_ description: String) { self.description = description }
+}
+
+/// The task item's OWN declaration of how its model output becomes the
+/// settlement result value. A task that declares no contract settles the raw
+/// generated text and token ids; a task that declares named fields settles the
+/// values captured by those declared patterns.
+///
+/// The entry never carries task-specific extraction logic: the field names and
+/// patterns come from the item's `source_payload.result_contract`, exactly like
+/// its input template and bindings come from the item's own declaration.
+struct TaskResultContract {
+  struct Field {
+    let name: String
+    let expression: NSRegularExpression
+  }
+
+  let fields: [Field]
+
+  init(payload: [String: Any]) throws {
+    guard let contract = payload["result_contract"] as? [String: Any] else {
+      fields = []
+      return
+    }
+    guard let rawFields = contract["fields"] as? [[String: Any]] else {
+      throw TaskEntryError("result_contract has no fields list")
+    }
+    fields = try rawFields.map { raw in
+      guard let name = raw["name"] as? String, !name.isEmpty,
+            let pattern = raw["pattern"] as? String, !pattern.isEmpty else {
+        throw TaskEntryError("result_contract field needs name and pattern")
+      }
+      do {
+        return Field(name: name, expression: try NSRegularExpression(pattern: pattern))
+      } catch {
+        throw TaskEntryError("result_contract field \(name) has an invalid pattern: \(error)")
+      }
+    }
+  }
+
+  /// Build the settlement value from the produced result alone. The admitted
+  /// input identity is included so the settlement record itself names the
+  /// dependency objects and input bytes the model consumed.
+  func value(
+    for produced: ExecutionContinuationResult,
+    admitted: ProductionTaskInputAdmission,
+    modelIdentity: [String: Any]
+  ) throws -> [String: Any] {
+    var value: [String: Any] = [
+      "raw_generated_text": produced.generatedText,
+      "generated_token_ids": produced.generatedTokenIDs,
+      "generated_token_count": produced.generatedTokenIDs.count,
+      "model_snapshot_revision": modelIdentity["snapshot_revision"] as? String ?? "",
+      "model_weights_manifest_sha256":
+        modelIdentity["weights_manifest_sha256"] as? String ?? "",
+      "model_call_index": 1,
+      "admitted_input_sha256": admitted.inputSHA256,
+      "admitted_dependency_settlement_object_ids":
+        admitted.dependencySettlementObjectIDs,
+    ]
+    for field in fields {
+      guard let captured = Self.capture(
+        field.expression, in: produced.generatedText) else {
+        throw TaskEntryError(
+          "model output does not contain declared result field \(field.name): "
+            + produced.generatedText)
+      }
+      value[field.name] = captured
+    }
+    return value
+  }
+
+  private static func capture(
+    _ expression: NSRegularExpression,
+    in text: String
+  ) -> String? {
+    let range = NSRange(location: 0, length: (text as NSString).length)
+    guard let match = expression.firstMatch(in: text, range: range),
+          match.numberOfRanges > 1,
+          let captured = Range(match.range(at: 1), in: text) else {
+      return nil
+    }
+    return String(text[captured])
+  }
+}
