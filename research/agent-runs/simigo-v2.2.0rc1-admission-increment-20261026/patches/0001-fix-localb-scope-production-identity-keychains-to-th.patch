     ) -> String? {
-        guard let home = env["SIMIGO_HOME"], !home.isEmpty else { return nil }
-        let root = URL(fileURLWithPath: (home as NSString).standardizingPath, isDirectory: true)
+        let root: URL
+        if let home = env["SIMIGO_HOME"], !home.isEmpty {
