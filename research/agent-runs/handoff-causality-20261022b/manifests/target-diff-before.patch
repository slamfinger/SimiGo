+    runLabel: String,
+    secret: String? = nil
+  ) throws -> [String: Any] {
+    var arguments = [
+      "--database", database.path,
+      "--evaluated-at", evaluatedAtUTC,
+      "--run-label", runLabel,
+    ]
+    if let secret {
+      arguments += ["--secret", secret]
+    }
+    return try runBridge("define-task", arguments: arguments)
+  }
